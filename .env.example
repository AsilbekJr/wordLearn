# ==============================================================================
# Linguist AI — Supabase Environment Configuration
# ==============================================================================
# 1. Supabase loyihangizni yarating (https://supabase.com)
# 2. Project Settings -> API boʻlimidan URL va anon public kalitni oling
# 3. Ushbu fayl nusxasini yarating va ".env.local" deb nomlang:
#    cp .env.example .env.local

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Ixtiyoriy) Supabase-ga seed maʼlumotlarini yuklash uchun:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
